<div class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="flex items-start justify-between mb-8">
      <div class="flex items-center space-x-6">
        <% if @influencer.avatar.attached? %>
          <%= image_tag @influencer.avatar, class: "h-24 w-24 rounded-full object-cover shadow-lg" %>
        <% else %>
          <div class="h-24 w-24 rounded-full bg-gray-200 flex items-center justify-center">
            <svg class="h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
        <% end %>
        <div>
          <h1 class="text-3xl font-bold tracking-tight text-gray-900"><%= @influencer.name %></h1>
          <% if @influencer.handle.present? %>
            <p class="text-sm text-gray-500 mt-1"><%= @influencer.handle %></p>
          <% end %>
          <% if @influencer.platform.present? %>
            <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10 mt-2"><%= @influencer.platform %></span>
          <% end %>
          <% if @influencer.follower_count.present? %>
            <p class="text-xs text-gray-400 mt-1"><%= number_with_delimiter(@influencer.follower_count) %> followers</p>
          <% end %>
        </div>
      </div>
      <% if signed_in? && current_user.admin? %>
        <div class="flex items-center gap-2">
          <%= link_to "Edit", edit_admin_influencer_path(@influencer), class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 transition-colors" %>
          <%= button_to "Remove", admin_influencer_path(@influencer), method: :delete, form: { data: { turbo_confirm: 'Are you sure?' } }, class: "rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 transition-colors" %>
        </div>
      <% end %>
    </div>

    <% if @influencer.bio.present? %>
      <p class="text-sm text-gray-600 mb-8 max-w-2xl"><%= @influencer.bio %></p>
    <% end %>

    <% if @influencer.profile_url.present? %>
      <div class="mb-8">
        <%= link_to @influencer.profile_url, @influencer.profile_url, target: "_blank", class: "text-sm text-indigo-600 hover:text-indigo-500" %>
      </div>
    <% end %>

    <h2 class="text-xl font-semibold text-gray-900 mb-6">Merch Items (<%= @items.count %>)</h2>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <% @items.each do |item| %>
        <div class="group relative bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-lg transition-all duration-200 overflow-hidden">
          <%= link_to item_path(item), class: "block" do %>
            <div class="aspect-[4/3] overflow-hidden bg-gray-100">
              <%= image_tag item.image.attached? ? item.image : "https://imageplaceholder.net/400x600", class: "h-full w-full object-cover object-center group-hover:scale-105 transition-transform duration-200" %>
            </div>
            <div class="p-4">
              <h3 class="text-sm font-semibold text-gray-900 group-hover:text-indigo-600 transition-colors"><%= item.title %></h3>
              <p class="text-xs text-gray-500 mt-1"><%= item.item_maker&.title || "Unknown Brand" %></p>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
