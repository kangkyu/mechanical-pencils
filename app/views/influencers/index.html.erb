<div class="bg-white">
  <div class="mx-auto max-w-2xl px-4 py-16 sm:px-6 sm:py-24 lg:max-w-7xl lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-gray-900 mb-8">Influencers</h2>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <% @influencers.each do |influencer| %>
        <%= link_to influencer_path(influencer), class: "group block" do %>
          <div class="relative bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-lg transition-all duration-200 overflow-hidden p-6">
            <div class="flex items-center space-x-4">
              <% if influencer.avatar.attached? %>
                <%= image_tag influencer.avatar.variant(:thumb), class: "h-16 w-16 rounded-full object-cover" %>
              <% else %>
                <div class="h-16 w-16 rounded-full bg-gray-200 flex items-center justify-center">
                  <svg class="h-8 w-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                </div>
              <% end %>
              <div class="min-w-0 flex-1">
                <h3 class="text-sm font-semibold text-gray-900 group-hover:text-indigo-600 transition-colors"><%= influencer.name %></h3>
                <% if influencer.handle.present? %>
                  <p class="text-xs text-gray-500"><%= influencer.handle %></p>
                <% end %>
                <% if influencer.platform.present? %>
                  <span class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10 mt-1"><%= influencer.platform %></span>
                <% end %>
              </div>
            </div>
            <p class="mt-3 text-xs text-gray-500"><%= pluralize influencer.items.count, "item" %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
